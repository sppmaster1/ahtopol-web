              "max-width": "800px"
            },
            "img, .item-img": {
              "width": "100%",
              "& when (@autoSize)": {
                "object-fit": "cover",
                "height": "100px"
              },
              "& when not (@autoSize)": {
                "height": "100%"
              }
            }
